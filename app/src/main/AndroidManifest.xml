<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to api.github.com to list your repos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the 15-minute background refresh scheduled after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <!-- The GitHub app: its icon on the button, and opening repos in it. -->
        <package android:name="com.github.android" />
        <!-- Lets the widget see apps with a home-screen icon, so it can match a repo to the
             app built from it (com.jono.<repo name>) and show its icon and installed build. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Finding your browser, so APK downloads open there rather than in the GitHub app. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Expand panel: floats over the home screen when you tap a small widget. -->
        <activity
            android:name=".PanelActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Panel" />

        <!-- Invisible: turns a tap on a list row into "open in GitHub", "open app" or "get update". -->
        <activity
            android:name=".OpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".RefreshJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Lets the launcher load repo/app icons by URI. It only serves the saved icons. -->
        <provider
            android:name=".IconProvider"
            android:authorities="com.jono.githubwidget.icons"
            android:exported="true" />

        <receiver
            android:name=".ReposWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
