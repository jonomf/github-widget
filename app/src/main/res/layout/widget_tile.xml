<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1: the round Repos icon on the wallpaper (no background). The update pip is drawn into
     the image itself (Apps.tileIcon), so it always sits on the icon's corner. Tap for the full list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/art"
        style="@style/Cover"
        android:layout_gravity="center" />
</FrameLayout>
