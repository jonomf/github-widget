<?xml version="1.0" encoding="utf-8"?>
<!-- 2+ rows: header (GitHub app, title, last refresh, refresh) over a scrolling list of repos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/gh" style="@style/GhButton" />
        <TextView android:id="@+id/title" style="@style/HeaderTitle" />
        <TextView android:id="@+id/updated" style="@style/Age" />
        <ImageView android:id="@+id/claude" style="@style/ClaudeLink" />
        <ImageView
            android:id="@+id/refresh"
            style="@style/IconButton"
            android:contentDescription="Refresh"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1">

        <ListView android:id="@+id/list" style="@style/RepoList" />
        <TextView android:id="@+id/empty" style="@style/Empty" />
    </FrameLayout>
</LinearLayout>
